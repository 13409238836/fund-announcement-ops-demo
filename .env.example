# DeepSeek API settings. Create a DeepSeek API key and paste it into your local .env file.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-with-your-deepseek-api-key
MODEL_NAME=deepseek-flash
# Optional: comma-separated model IDs available through the same provider and API key.
MODEL_AVAILABLE_MODELS=deepseek-flash
PORT=4173
# Required for a public deployment (Node Basic Auth behind HTTPS).
# DEMO_ACCESS_USER=operator
# DEMO_ACCESS_PASSWORD=replace-with-a-long-random-password
